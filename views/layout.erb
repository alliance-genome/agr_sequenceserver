<% require 'net/http' %>
<% require 'json' %>
<% require 'uri' %>

<!DOCTYPE html>
<html lang="en">

<head>
  <title>SequenceServer: Custom BLAST Server</title>
  <meta name="author" content="Pragmatic Genomics Limited"/>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Custom BLAST server provided by SequenceServer (https://sequenceserver.com)"/>
  <% # Detect protocol properly to avoid mixed content issues %>
  <% if request.env['HTTP_X_FORWARDED_PROTO'] == 'https' || request.port == 443 || ENV['HTTPS'] == 'on' || request.host.include?('alliancegenome.org') %>
    <% base_url_protocol = 'https' %>
  <% else %>
    <% base_url_protocol = request.scheme %>
  <% end %>
  <% base_url = "#{base_url_protocol}://#{request.host}" %>
  <% base_url << ":#{request.port}" unless [80, 443].include?(request.port) %>
  <!-- CSS -->
  <%= Rack::Csrf.metatag(env) %>
  <link rel="stylesheet" media="screen,print" type="text/css" href="<%= "#{base_url}" %>/blast/css/app.min.css?v=<%= asset_version('css/app.min.css') %>"/>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <!--
  <% if settings.production? || settings.test? %>
    <link rel="stylesheet" media="screen,print" type="text/css" href="<%= "#{base_url}" %>/blast/css/sequenceserver.min.css?ver=<%= SequenceServer::VERSION %>"/>
  <% else %>
    <link rel="stylesheet" media="screen,print" type="text/css" href="<%= "#{base_url}/blast/css/sequenceserver.css"%>"/>
  <% end %>
  -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-98765810-1"></script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-H3F65KGJDR"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    // UA tracking
    gtag('config', 'UA-98765810-1');

    // GA4 tracking
    gtag('config', 'G-H3F65KGJDR');
  </script>
</head>

<% segment = request.path.split("/")[2] %>

<% member_map = {
  "FB" => "flybase",
  "MGD" => "mgd",
  "RGD" => "rgd",
  "SGD" => "sgd",
  "WB" => "wormbase",
  "ZFIN" => "zfin",
  "XB" => "xenbase",
  "AGR" => "agr"
}
member_key = member_map[segment] %>

<% member_path = case segment
  when "FB" then "flybase"
  when "MGD" then "mgd"
  when "RGD" then "rgd"
  when "SGD" then "sgd"
  when "WB" then "wormbase"
  when "ZFIN" then "zfin"
  when "XB" then "xenbase"
  else segment
end %>

<% member_name = case segment
  when "FB" then "FlyBase"
  when "MGD" then "MGD"
  when "RGD" then "RGD"
  when "SGD" then "SGD"
  when "WB" then "WormBase"
  when "ZFIN" then "ZFIN"
  when "XB" then "XenBase"
  else ""
end %>

<% data_version = request.path.split("/")[3] %>

<%
member_key = segment ? member_map[segment.upcase] : nil

member_logo_url = nil

if member_key
  begin
    manifest_uri = URI("https://www.alliancegenome.org/asset-manifest.json")
    manifest_response = Net::HTTP.get(manifest_uri)
    manifest = JSON.parse(manifest_response)
    src_key = "src/assets/images/alliance_logo_#{member_key}.png"

    if manifest[src_key] && manifest[src_key]['file']
      member_logo_url = "https://www.alliancegenome.org/#{manifest[src_key]['file']}"
    end

  rescue => e
    logger.error "[ERROR] Problem fetching/parsing manifest: #{e.message}"
  end
end
%>

  <%= erb :_alliance_nav, layout: false %>

  <header id="header" class="border-b border-alliance print:hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <%# Wraps rather than overflows. The three blocks here -- the Alliance logo,
          the member logo and title, and the attribution -- total more than 700px,
          and as a non-wrapping row they pushed the version number past the right
          edge of the page and gave the whole document a horizontal scrollbar. %>
      <div class="flex flex-wrap items-center">
        <div class="py-4">
          <a href="https://alliancegenome.org" target="_blank" class="flex items-end">
            <img src="/blast/logos/alliance_logo_agr.png" alt="agr_logo" width="405" height="53">
          </a>
        </div>
        <div class="py-8" style="padding-left:20px">
          <a href="https://www.alliancegenome.org/members/<%= member_path %>" target="_blank" class="flex items-end">
            <img id="alliance-member-logo" src="<%= member_logo_url || '/blast/logos/alliance_logo_agr.png' %>" alt="Alliance MOD logo" width="100" height="100">
            <%# Assembled rather than interpolated inline: the Alliance-wide deployment
                has no member name, and concatenating an empty one left the heading
                as " BLAST" with a leading space. %>
            <% page_title = [member_name,
                             (data_version && data_version.end_with?('f') ? 'Fungal' : nil),
                             'BLAST'].reject { |part| part.nil? || part.empty? }.join(' ') %>
            <strong class="agr-title"><%= page_title %></strong>
            <span class="agr-beta" title="This service is still in beta">BETA</span>
          </a>
        </div>
        <%# The data version, and only the data version.

            The SequenceServer attribution used to sit here too, and the two
            competed: a credit does not belong beside the one fact on this page
            a curator actually acts on. The attribution moved to the colophon,
            which leaves the version the whole block -- set large, in ink, above
            its label. %>
        <div class="agr-meta py-4">
          <div class="agr-dataversion">
            <span class="agr-dv-value" data-data-version="<%= data_version %>"><%= data_version %></span>
            <span class="agr-dv-label">Data version</span>
          </div>
        </div>
      </div>
    </div>
  </header>


  <!-- <script type="text/javascript" src="<%= "#{base_url}" %>/blast/resource_logo.js"></script> -->
  <noscript>
    <div class="mx-auto px-4">
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
        <strong class="font-bold">Our website cannot work without JavaScript.</strong>
        <ul class="mt-2 list-disc list-inside">
          <li>Please see if you can enable JavaScript in your browser's preferences.</li>
          <li>If your browser doesn't support JavaScript, please consider upgrading to the latest version or using Firefox or Chrome.</li>
        </ul>
      </div>
    </div>
  </noscript>

  <%= yield %>

  <%= erb :_alliance_footer, layout: false %>

</body>
</html>
