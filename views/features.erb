<% # Detect protocol properly to avoid mixed content issues %>
<% if request.env['HTTP_X_FORWARDED_PROTO'] == 'https' || request.port == 443 || ENV['HTTPS'] == 'on' || request.host.include?('alliancegenome.org') %>
  <% base_url_protocol = 'https' %>
<% else %>
  <% base_url_protocol = request.scheme %>
<% end %>
<% base_url = "#{base_url_protocol}://#{request.host}" %>
<% base_url << ":#{request.port}" unless [80, 443].include?(request.port) %>

<div class="container mx-auto max-w-4xl p-8">
  <h1 class="text-3xl font-bold mb-8">Features & Roadmap</h1>

  <div class="mb-12">
    <h2 class="text-2xl font-bold mb-6">Current Features</h2>
    <div class="bg-white border rounded-lg p-6">
      <ul class="space-y-3 text-lg">
        <li>✅ JBrowse2 genome browser integration</li>
        <li>✅ Extended E-value options (1e+4 to 1e-32)</li>
        <li>✅ WormBase and FlyBase chromosome links</li>
        <li>✅ Auto-expansion of common organisms</li>
        <li>✅ MOD-specific database organization</li>
      </ul>
    </div>
  </div>

  <div class="mb-12">
    <h2 class="text-2xl font-bold mb-6">Next Priority</h2>
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <ul class="space-y-3 text-lg">
        <li>🔧 Add remaining MODs (SGD, ZFIN, MGI, RGD, Xenbase)</li>
        <li>🔧 Improve search interface based on FlyBase feedback</li>
        <li>🔧 Pre-select primary species for each MOD</li>
        <li>🔧 Move controls above species selection</li>
      </ul>
    </div>
  </div>

  <div class="mb-12">
    <h2 class="text-2xl font-bold mb-6">Future Plans</h2>
    <div class="bg-white border rounded-lg p-6">
      <div class="space-y-6">
        <div>
          <h3 class="text-xl font-semibold mb-3">Search & Results</h3>
          <ul class="space-y-2 text-lg">
            <li>• Interactive alignment visualization</li>
            <li>• Batch sequence processing</li>
            <li>• Search history and bookmarks</li>
            <li>• Export to external tools</li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-3">Integration</h3>
          <ul class="space-y-2 text-lg">
            <li>• RESTful API for programmatic access</li>
            <li>• MOD website embedding</li>
            <li>• Galaxy workflow integration</li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold mb-3">User Features</h3>
          <ul class="space-y-2 text-lg">
            <li>• User accounts and saved searches</li>
            <li>• Job notifications</li>
            <li>• Collaborative workspaces</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="text-center">
    <a href="<%= base_url %>/blast/" class="text-blue-600 hover:text-blue-800 text-lg">
      ← Back to BLAST Search
    </a>
  </div>
</div>