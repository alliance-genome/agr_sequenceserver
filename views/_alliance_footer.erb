<%
  # Colophon and footer.
  #
  # The footer is alliancegenome.org's own footer, reproduced: their light logo
  # and the same six site-map groups, on their blue, in Lato. Read off their
  # live site on 2026-09-30 -- the group order, the link order and the labels
  # are theirs, not ours, so a visitor leaves this page into the same set of
  # destinations they would have from any other Alliance page.
  #
  # Two consequences worth knowing. This is a static copy: when they change
  # their footer, this does not follow, and nobody currently owns re-checking
  # it. And the arrow marks the links that leave the Alliance site entirely,
  # which is their convention, so it is applied to the same links they apply
  # it to rather than to every absolute URL.
  #
  # Above it sits the colophon, which carries what is ours rather than theirs:
  # the attribution, the in-development caveat and the two citations.
  alliance_footer = [
    ['Data and Tools', [
      ['Downloads',        '/downloads',                  false],
      ['API',              '/swagger-ui',                 true],
      ['AllianceMine',     '/bluegenes/alliancemine',     true],
      ['JBrowse 2',        '/jbrowse2/',                  true],
      ['Disease Portal',   '/disease-portal',             false],
      ['Ontology Browser', '/ontology/disease',           false],
      ['SimpleMine',       '/agr_simplemine.cgi',         true],
      ['Submit Data',      '/submit-data',                false],
      ['Textpresso',       '/textpresso',                 false],
      ['BLAST Service',    '/blastservice',               false],
      ['Tools',            '/prototypes',                 false],
      ['Pavi',             '/pavi',                       true]
    ]],
    ['Members', [
      ['FlyBase',   '/members/flybase',  false],
      ['MGD',       '/members/mgd',      false],
      ['RGD',       '/members/rgd',      false],
      ['SGD',       '/members/sgd',      false],
      ['WormBase',  '/members/wormbase', false],
      ['Xenbase',   '/members/xenbase',  false],
      ['ZFIN',      '/members/zfin',     false],
      ['GOC',       '/members/goc',      false]
    ]],
    ['News', [
      ['News / Events',  '/news',           false],
      ['Release Notes',  '/release-notes',  false],
      ['Event Calendar', '/event-calendar', false]
    ]],
    ['About', [
      ['About Us',           '/about-us',                     false],
      ['Funding',            '/funding',                      false],
      ['Publications',       '/publications',                 false],
      ['Organization',       '/organization-and-governance',  false],
      ['Licensing, Privacy', '/privacy-warranty-licensing',   false]
    ]],
    ['Help', [
      ['FAQ',       '/faq',       false],
      ['Glossary',  '/glossary',  false],
      ['Tutorials', '/tutorials', false],
      ['User Docs', '/help',      false]
    ]],
    ['Community', [
      ['Alliance Users', 'https://community.alliancegenome.org/categories',        true],
      ['Facebook',       'https://www.facebook.com/AllianceOfGenomeResources',     true],
      ['Mastodon',       'https://genomic.social/@AllianceGenome',                 true],
      ['Bluesky',        'https://bsky.app/profile/alliancegenome.bsky.social',    true],
      ['Github',         'https://github.com/alliance-genome',                     true],
      ['Contact Us',     '/contact-us',                                            false],
      ['Cite Us',        '/cite-us',                                               false]
    ]]
  ]

  agr = 'https://www.alliancegenome.org'
%>
<section class="agr-colophon print:break-inside-avoid" aria-labelledby="agr-colophon-h">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <%# Attribution lives here rather than in the page header. It is a credit,
        and next to the name of the service and the data version it was
        competing with both. %>
    <div class="agr-colophon-top">
      <div class="agr-poweredby">
        <span>Powered by</span>
        <a href="https://sequenceserver.com" target="_blank" rel="noopener">
          <img src="/blast/sequenceserver_logo.webp" alt="SequenceServer" width="1620" height="213">
          <span class="agr-ss-version"><%= SequenceServer::VERSION %></span>
        </a>
      </div>

      <div class="agr-notice" role="note">
        <span class="agr-notice-tag">In development</span>
        <p>JBrowse genome browser links may not resolve correctly for every
        organism yet. The rest of the service is unaffected.</p>
      </div>
    </div>

    <h2 id="agr-colophon-h" class="agr-colophon-h">If you use this service, please cite</h2>

    <dl class="agr-cites">
      <div class="agr-cite">
        <dt>Data</dt>
        <dd>
          <p class="agr-cite-authors">Bult CJ, Sternberg PW.</p>
          <p class="agr-cite-title">The Alliance of Genome Resources: transforming
          comparative genomics.</p>
          <p class="agr-cite-where"><i>Mamm Genome</i> 2023;34(4):531&ndash;44.</p>
          <p class="agr-cite-ids">
            <a href="https://doi.org/10.1007/s00335-023-10015-2">doi:10.1007/s00335-023-10015-2</a>
            <span class="agr-dot" aria-hidden="true">&middot;</span>
            <a href="https://pubmed.ncbi.nlm.nih.gov/37666946/">PMID&nbsp;37666946</a>
          </p>
        </dd>
      </div>

      <div class="agr-cite">
        <dt>BLAST service</dt>
        <dd>
          <%# 24 authors. Shown in full on request rather than by default: the
              citation a reader needs is the DOI, and the list buried it.

              Collapsed by the script below, not by markup: with no JavaScript
              the full list stays visible and the button -- which would do
              nothing -- never appears. %>
          <p class="agr-cite-authors">Priyam A, Woodcroft BJ, Rai V, <i>et&nbsp;al.</i>
            <button type="button" class="agr-more" data-agr-more="ss-authors"
                    aria-expanded="true" aria-controls="ss-authors" hidden>all authors</button>
          </p>
          <p class="agr-cite-authors agr-cite-all" id="ss-authors">Anurag Priyam,
          Ben J Woodcroft, Vivek Rai, Ismail Moghul, Alekhya Munagala, Filip Ter, Hiten
          Chowdhary, Iwo Pieniak, Lawrence J Maynard, Mark Anthony Gibbins, HongKee Moon,
          Austin Davis-Richardson, Mahmut Uludag, Nathan S Watson-Haigh, Richard Challis,
          Hiroyuki Nakamura, Emeline Favreau, Esteban A G&oacute;mez, Tom&aacute;&scaron;
          Pluskal, Guy Leonard, Wolfgang Rumpf, Yannick Wurm.</p>
          <p class="agr-cite-title">Sequenceserver: a modern graphical user interface for
          custom BLAST databases.</p>
          <p class="agr-cite-where"><i>Molecular Biology and Evolution</i>
          2019;36(12):2922&ndash;2924.</p>
          <p class="agr-cite-ids">
            <a href="https://doi.org/10.1093/molbev/msz185">doi:10.1093/molbev/msz185</a>
            <span class="agr-dot" aria-hidden="true">&middot;</span>
            <a href="https://pubmed.ncbi.nlm.nih.gov/31411700/">PMID&nbsp;31411700</a>
          </p>
        </dd>
      </div>
    </dl>
  </div>
</section>

<footer id="alliance-footer" class="print:hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="agr-footer-row">
      <div class="agr-footer-logo">
        <a href="<%= agr %>">
          <img src="/blast/logos/alliance_logo_light.png"
               alt="Alliance of Genome Resources" width="842" height="200">
        </a>
      </div>

      <nav class="agr-sitemap" aria-label="Alliance of Genome Resources site map">
        <% alliance_footer.each do |heading, entries| %>
          <div class="agr-sitemap-group">
            <span class="agr-sitemap-h"><%= heading %></span>
            <ul>
              <% entries.each do |label, href, external| %>
                <li>
                  <a href="<%= href.start_with?('http') ? href : agr + href %>"
                     <%= 'target="_blank" rel="noopener noreferrer"' if external %>><%= label %><%
                    if external %><i class="fa-solid fa-arrow-up-right-from-square agr-ext" aria-hidden="true"></i><% end
                  %></a>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </nav>
    </div>
  </div>
</footer>

<script>
  // Collapses the long author list and reveals the button that expands it.
  // Runs here rather than in a bundle: the colophon is rendered by the layout,
  // so it is present on every page, including ones that load no React bundle.
  (function () {
    var buttons = document.querySelectorAll('[data-agr-more]');
    for (var i = 0; i < buttons.length; i++) {
      (function (button) {
        var target = document.getElementById(button.getAttribute('data-agr-more'));
        if (!target) return;
        target.hidden = true;
        button.hidden = false;
        button.setAttribute('aria-expanded', 'false');
        button.addEventListener('click', function () {
          var open = target.hidden;
          target.hidden = !open;
          button.setAttribute('aria-expanded', String(open));
          button.textContent = open ? 'fewer authors' : 'all authors';
        });
      })(buttons[i]);
    }
  })();
</script>
