:host: 0.0.0.0
:port: 4567
:databases_widget: tree
:options:
  :blastn:
    :default:
      - "-task blastn"
      - "-evalue 1e-5"
      - "-max_target_seqs 100"
    :short-seq:
      - "-task blastn-short"
      - "-evalue 1e-1"
    :evalue_options:
      - 1e-1
      - 1e-5
      - 1e-10
      - 1e-20
    :max_target_seqs_options:
      - 10
      - 50
      - 100
      - 250
      - 500
  :blastp:
    :default:
      - "-evalue 1e-5"
      - "-max_target_seqs 100"
    :evalue_options:
      - 1e-5
      - 1e-10
      - 1e-20
    :max_target_seqs_options:
      - 50
      - 100
      - 250
  :blastx:
    :default:
       - "-evalue 1e-5"
       - "-max_target_seqs 100"
  :tblastx:
    :default:
       - "-evalue 1e-5"
       - "-max_target_seqs 100"
  :tblastn:
    :default:
      - "-evalue 1e-5"
      - "-max_target_seqs 100"
:num_threads: 1
:num_jobs: 1
:job_lifetime: 43200
:database_dir: "/db"
